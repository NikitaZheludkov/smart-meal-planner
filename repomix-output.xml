        const q = searchQuery.value.toLowerCase()
        result = result.filter(p => p.name.toLowerCase().includes(q))
    }
    
    return result
})

onMounted(async () => {
    if (productStore.products.length === 0) {
        await productStore.fetchProducts()
    }
})
</script>

